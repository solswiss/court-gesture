{
  "name": "court-gesture",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://solswiss.github.io",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "rules": "tsx scripts/rules-test.ts",
    "sim": "tsx scripts/sim-test.ts",
    "test": "tsx scripts/network-test.ts && tsx scripts/hand-test.ts && tsx scripts/rules-test.ts && tsx scripts/sim-test.ts 5",
    "test:hand": "tsx scripts/hand-test.ts",
    "test:network": "tsx scripts/network-test.ts",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.32",
    "peerjs": "^1.5.5",
    "three": "~0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "~0.170.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21"
  }
}
